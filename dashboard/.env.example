# Copy this file to ".env" (same folder) and fill in real values from
# your Learner Lab session ("AWS Details" -> "Show" next to "AWS CLI").
# .env itself is gitignored -- never committed. You'll still need to
# update it every time your Learner Lab session refreshes (every few
# hours), but at least you won't retype it in every new terminal.

AWS_ACCESS_KEY_ID=ASIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_very_long_session_token_here
AWS_REGION=us-east-1
